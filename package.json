{
  "name": "jpti-trading-intelligence",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --watch api/server.js",
    "start:api": "node api/server.js",
    "dev:all": "concurrently \"npm:dev\" \"npm:dev:api\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node --check api/server.js && node --check api/exchanges.js && node --check api/intelligence.js && node --check api/providers.js && node --check api/market-intelligence.js && node --check api/operations.js && node --check api/policy.js",
    "test": "node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0",
    "ccxt": "^4.5.93",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
