# JPTI server-side configuration. Copy to .env; NEVER use VITE_ prefixes for secrets.
JPTI_API_HOST=127.0.0.1
JPTI_API_PORT=8787
# Capacitor Android WebView origins; add only origins you trust.
JPTI_CORS_ORIGINS=https://localhost,capacitor://localhost
# Enabled only by the packaged desktop app, whose API binds exclusively to loopback.
JPTI_ALLOW_LOCAL_PRIVATE_ACCESS=false
JPTI_TRADING_MODE=paper
JPTI_ENABLE_LIVE_TRADING=false
JPTI_API_TOKEN=replace-with-a-long-random-secret
JPTI_MAX_ORDER_NOTIONAL_USDT=100
JPTI_EXCHANGE_TIMEOUT_MS=15000

# Add credentials only for exchanges you actually use. Disable withdrawals.
JPTI_BINANCE_API_KEY=
JPTI_BINANCE_API_SECRET=
JPTI_BYBIT_API_KEY=
JPTI_BYBIT_API_SECRET=
JPTI_BYBIT_PASSWORD=
JPTI_OKX_API_KEY=
JPTI_OKX_API_SECRET=
JPTI_OKX_PASSWORD=
JPTI_KUCOIN_API_KEY=
JPTI_KUCOIN_API_SECRET=
JPTI_KUCOIN_PASSWORD=
JPTI_KRAKEN_API_KEY=
JPTI_KRAKEN_API_SECRET=
JPTI_COINBASE_API_KEY=
JPTI_COINBASE_API_SECRET=
JPTI_BITGET_API_KEY=
JPTI_BITGET_API_SECRET=
JPTI_BITGET_PASSWORD=
JPTI_GATEIO_API_KEY=
JPTI_GATEIO_API_SECRET=
JPTI_MEXC_API_KEY=
JPTI_MEXC_API_SECRET=
JPTI_HTX_API_KEY=
JPTI_HTX_API_SECRET=
# Any adapter shipped in the installed CCXT package can be configured with JPTI_<EXCHANGE_ID>_API_KEY / API_SECRET.

# Financial and on-chain intelligence providers (server-side only)
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
JPTI_FRED_API_KEY=
# Alchemy: address transfer history for Ethereum, Base, Polygon, Arbitrum and Optimism
JPTI_ALCHEMY_API_KEY=
# Helius: Solana enhanced address transaction history
JPTI_HELIUS_API_KEY=


# Additional financial data providers (server-side only; never use VITE_ prefixes)
JPTI_ALPACA_API_KEY=
JPTI_ALPACA_API_SECRET=
JPTI_QUIVER_API_KEY=
JPTI_FINNHUB_API_KEY=
JPTI_ALPHAVANTAGE_API_KEY=
JPTI_TWELVEDATA_API_KEY=
JPTI_INFURA_API_KEY=
# Liquid/Quoine is retained only as a public legacy products probe; it is not an active execution venue.
JPTI_LIQUID_API_BASE_URL=https://api.liquid.com

# Operational polling intervals (SECONDS)
JPTI_SCHEDULER_ENABLED=true
# PostgreSQL deployments coordinate one active scheduler leader across API instances.
JPTI_SCHEDULER_LEASE_MS=30000
JPTI_SCHEDULER_HEARTBEAT_MS=10000
# Optional stable identifier for logs/operations; generated automatically when omitted.
JPTI_SCHEDULER_INSTANCE_ID=
JPTI_MM_INTERVAL_SECONDS=5
JPTI_MARKET_MONITOR_INTERVAL_SECONDS=5
JPTI_MARKET_DATA_REFRESH_INTERVAL_SECONDS=5
JPTI_RECONCILE_INTERVAL_SECONDS=30
JPTI_INVESTOR_MONITOR_INTERVAL_SECONDS=60
JPTI_PROVIDER_HEALTH_INTERVAL_SECONDS=300
JPTI_NEWS_REFRESH_INTERVAL_SECONDS=60
JPTI_ONCHAIN_REFRESH_INTERVAL_SECONDS=30


# Live scheduled market monitor (comma-separated exchange:symbol entries)
JPTI_MONITOR_MARKETS=
# Private fill-history polling (read-only API keys; comma-separated exchange:symbol entries)
JPTI_FILL_SYNC_MARKETS=
# Historical fill sync controls (bounded pages; overlaps recover late-arriving fills)
JPTI_FILL_SYNC_LOOKBACK_DAYS=7
JPTI_FILL_SYNC_PAGE_SIZE=250
JPTI_FILL_SYNC_MAX_PAGES=20
JPTI_FILL_SYNC_OVERLAP_MINUTES=3
# T-Bots multi-chain DEX token watchlist (chain:contract-address entries, max 60)
JPTI_TBOTS_DEX_WATCHLIST=
# T-Bots cross-exchange spot paper watchlist (exchange:symbol entries, max 30)
JPTI_TBOTS_CEX_MARKETS=binance:BTC/USDT,binance:ETH/USDT,binance:SOL/USDT,bitget:BTC/USDT,bitget:ETH/USDT
JPTI_TBOTS_MAX_CONSECUTIVE_LOSSES=3
JPTI_TBOTS_DAILY_LOSS_LIMIT_USD=100
# Maximum age accepted by the shared T-Bots paper-entry evidence preflight (15–300 seconds)
JPTI_TBOTS_PREFLIGHT_MAX_EVIDENCE_AGE_SECONDS=90
# Persist monitor snapshots less frequently than ticker sampling
JPTI_MONITOR_PERSIST_INTERVAL_SECONDS=60
# Durable local event ledger directory (keep outside public/static folders)
JPTI_DATA_DIR=data

# Cross-provider quote validation (read-only; credentials remain server-side)
JPTI_QUOTE_CACHE_TTL_MS=30000
JPTI_QUOTE_STALE_AFTER_SECONDS=900
JPTI_QUOTE_OUTLIER_THRESHOLD_PERCENT=1.5
# Alpha Vantage is opt-in for consensus because free-tier daily quotas are restrictive.
JPTI_ENABLE_ALPHAVANTAGE_CONSENSUS=false
# Optional provider-specific minimum request spacing overrides (milliseconds)
# JPTI_FINNHUB_MIN_INTERVAL_MS=1000
# JPTI_TWELVEDATA_MIN_INTERVAL_MS=8000
# JPTI_ALPACA_MIN_INTERVAL_MS=500

# Cross-exchange quote outlier threshold (percentage)
JPTI_CROSS_VENUE_OUTLIER_PERCENT=0.5

# Read-only account balance reconciliation (opening balances are required for variance checks)
JPTI_RECONCILE_EXCHANGES=
# JSON object keyed by exchange ID, then currency; populate only with verified opening balances
JPTI_RECONCILE_OPENING_BALANCES_JSON={}

# Storage backend: file (local default) or postgres (production durable storage)
JPTI_STORAGE_BACKEND=file
# PostgreSQL connection string (required when JPTI_STORAGE_BACKEND=postgres)
DATABASE_URL=
# Enable TLS for managed/cloud PostgreSQL; certificate verification stays enabled by default
JPTI_DATABASE_SSL=false
JPTI_DATABASE_SSL_REJECT_UNAUTHORIZED=true
JPTI_DATABASE_POOL_MAX=10


# Phase 10 institutional paper governance (paper-only sizing caps)
JPTI_GOVERNANCE_MIN_CLOSED_TRADES=20
JPTI_GOVERNANCE_MIN_PROFIT_FACTOR=1.05
JPTI_GOVERNANCE_MAX_TRIAL_SIZE_PCT=1
JPTI_GOVERNANCE_VALIDATED_SIZE_PCT=2


# Phase 11 Universal Futures Cross-Exchange Intelligence
JPTI_FUTURES_CACHE_MS=2000
JPTI_FUTURES_ESTIMATED_TAKER_FEE_BPS=6
JPTI_FUTURES_UNIVERSE_CACHE_MS=900000

# Maximum simulated quote notional for each futures paper leg (USDT)
JPTI_FUTURES_PAPER_MAX_NOTIONAL_USD=1000
